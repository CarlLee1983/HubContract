# Per-worktree isolation for the recording environment (Issue #8).
#
# docker-compose.yml, scripts/env-*.sh and src/config.ts all read these same
# variable names, from the same file — either real environment variables, or
# this project-root `.env` (docker compose auto-loads it for variable
# interpolation; scripts source it explicitly; Bun auto-loads it for
# `bun test`/`bun run`).
#
# Copy this file to `.env` (gitignored) and change the values below when you
# need a second recording environment running at the same time as another one
# on this machine — e.g. a second `git worktree` checkout of this repo working
# on a different issue. Each worktree needs its own Docker Compose project
# name, host ports and docker network subnet so `docker compose up` in one
# doesn't collide with, stop, or reset the other's containers.

COMPOSE_PROJECT_NAME=hubcontract

DB_PORT=33066
REDIS_PORT=63799
MONGO_PORT=27018
LEGACY_PORT=8080
MOCK_PROVIDER_PORT=18081

# Fixed subnet/gateway (avoids common host subnets like 192.168.0.0/24,
# 192.168.1.0/24) so the host->container source IP that HUB_MCP_ALLOWED_IPS
# relies on (Issue #7) doesn't drift on every `docker compose down && up`.
# Each worktree needs its own subnet — Docker refuses to start a network that
# overlaps an existing one.
SUBNET=172.29.0.0/24
GATEWAY=172.29.0.1

# Read by src/config.ts and the CLI/tests (must point at the ports above).
HUBCONTRACT_BASE_URL=http://localhost:8080
HUBCONTRACT_STUB_URL=http://localhost:18081

# How long (seconds) Legacy waits before timing out an outbound call to sbo —
# shared by docker-compose.yml's GAMELOBBY_HTTP_PLATFORM_OVERRIDES and
# src/config.ts (code review Standards #10). Only needs overriding if a
# scenario's stub delayMs assertion needs a different margin.
GAMELOBBY_SBO_TIMEOUT_SECONDS=2
