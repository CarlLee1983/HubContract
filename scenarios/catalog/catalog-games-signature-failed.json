{
  "id": "catalog-games-signature-failed",
  "name": "Catalog games: signature failed",
  "description": "Invalid signature is rejected before the controller.",
  "route": {
    "method": "GET",
    "path": "/v1/games"
  },
  "tags": [
    "catalog",
    "games",
    "signature-failed",
    "CAP-09",
    "CAP-01",
    "BR-01",
    "BR-70"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "station_code": "DEMO_STATION",
      "timestamp": 0,
      "sign": "invalid_signature_hex_value_12345"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ]
}
