{
  "id": "catalog-types-success",
  "name": "Catalog types: success",
  "description": "Global game types include the synthetic active rows.",
  "route": {
    "method": "GET",
    "path": "/v1/games/types"
  },
  "tags": [
    "catalog",
    "types",
    "success",
    "CAP-09",
    "CAP-01",
    "BR-01"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "station_code": "DEMO_STATION",
      "timestamp": 0
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ],
  "dbProbe": {
    "queries": [
      {
        "name": "game_types",
        "sql": "SELECT id, name, active FROM game_types WHERE deleted_at IS NULL ORDER BY id",
        "params": []
      }
    ]
  }
}
