{
  "id": "catalog-companies-success",
  "name": "Catalog companies: success",
  "description": "Baseline active station game companies; missing cost_percent yields game_type array.",
  "route": {
    "method": "GET",
    "path": "/v1/games/companies"
  },
  "tags": [
    "catalog",
    "companies",
    "success"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "station_code": "DEMO_STATION",
      "timestamp": 0
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ],
  "dbProbe": {
    "queries": [
      {
        "name": "station_companies",
        "sql": "SELECT sgc.id, sgc.game_company_id, sgc.game_company_name, sgc.active, sgc.currency FROM station_game_companies sgc JOIN stations s ON s.id = sgc.station_id WHERE s.code = ? AND sgc.deleted_at IS NULL ORDER BY sgc.id",
        "params": [
          "DEMO_STATION"
        ]
      }
    ]
  }
}
