{
  "id": "catalog-types-signature-failed",
  "name": "Catalog types: signature failed",
  "description": "Invalid signature is rejected before the controller.",
  "route": {
    "method": "GET",
    "path": "/v1/games/types"
  },
  "tags": [
    "catalog",
    "types",
    "signature-failed",
    "CAP-09",
    "CAP-01",
    "BR-01"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "station_code": "DEMO_STATION",
      "timestamp": 0,
      "sign": "invalid_signature_hex_value_12345"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ],
  "dbProbe": {
    "queries": [
      {
        "name": "station",
        "sql": "SELECT id, code, cost_percent FROM stations WHERE code = ? AND deleted_at IS NULL ORDER BY id",
        "params": [
          "DEMO_STATION"
        ]
      },
      {
        "name": "game_types",
        "sql": "SELECT id, name, active FROM game_types WHERE deleted_at IS NULL ORDER BY id",
        "params": []
      }
    ]
  },
  "mongoProbe": {
    "pattern": "httplog_*"
  }
}
