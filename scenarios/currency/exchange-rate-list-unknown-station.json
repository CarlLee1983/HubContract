{
  "id": "currency-exchange-rate-list-unknown-station",
  "name": "Currency exchange rate list unknown station",
  "description": "Records Legacy currency route exchange-rate-list-unknown-station.",
  "route": {
    "method": "GET",
    "path": "/v1/currencies/exchange-rate"
  },
  "tags": [
    "currency",
    "exchange-rate-list",
    "unknown-station"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "timestamp": 0,
      "station_code": "NON_EXISTENT_STATION",
      "sign": "dummy_sign_for_unknown_station"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ]
}
