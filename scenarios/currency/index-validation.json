{
  "id": "currency-index-validation",
  "name": "Currency index validation",
  "description": "Records Legacy currency route index-validation.",
  "route": {
    "method": "GET",
    "path": "/v1/currencies"
  },
  "tags": [
    "currency",
    "index",
    "validation",
    "CAP-14",
    "CAP-01",
    "BR-01"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "timestamp": 0
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ],
  "dbProbe": {
    "queries": [
      {
        "name": "station",
        "sql": "SELECT id, code, cost_percent FROM stations WHERE code = ? AND deleted_at IS NULL ORDER BY id",
        "params": [
          "DEMO_STATION"
        ]
      },
      {
        "name": "station_currencies",
        "sql": "SELECT sc.id, sc.currency, sc.status FROM station_currencies sc JOIN stations s ON s.id = sc.station_id WHERE s.code = ? AND sc.deleted_at IS NULL ORDER BY sc.id",
        "params": [
          "DEMO_STATION"
        ]
      }
    ]
  },
  "mongoProbe": {
    "pattern": "httplog_*"
  }
}
