{
  "id": "currency-exchange-rate-show-inactive-currency",
  "name": "Currency exchange rate show inactive currency",
  "description": "Records Legacy exchange-rate lookup for USD.",
  "route": {
    "method": "GET",
    "path": "/v1/currencies/exchange-rate/USD"
  },
  "tags": [
    "currency",
    "exchange-rate-show",
    "inactive-currency"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "timestamp": 0,
      "station_code": "DEMO_STATION"
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ]
}
