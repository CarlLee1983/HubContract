{
  "id": "currency-exchange-rate-show-signature-failed",
  "name": "Currency exchange rate show signature failed",
  "description": "Records Legacy exchange-rate lookup for TWD.",
  "route": {
    "method": "GET",
    "path": "/v1/currencies/exchange-rate/TWD"
  },
  "tags": [
    "currency",
    "exchange-rate-show",
    "signature-failed",
    "CAP-14",
    "CAP-01",
    "BR-01",
    "BR-92"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "timestamp": 0,
      "station_code": "DEMO_STATION",
      "sign": "invalid_signature_hex_value_12345"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ]
}
