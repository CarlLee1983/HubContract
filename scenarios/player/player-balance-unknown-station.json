{
  "route": {
    "method": "GET",
    "path": "/v1/player/balance"
  },
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "account": "synthetic_user_01",
      "station_code": "NON_EXISTENT_STATION",
      "currency": "TWD",
      "timestamp": 0,
      "sign": "dummy_sign_for_unknown_station"
    }
  },
  "normalizers": [
    {
      "target": "request.query.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ],
  "id": "player-balance-unknown-station",
  "name": "Player Balance: Unknown Station",
  "description": "Unknown station_code fails during route provider initialization before request validation.",
  "tags": [
    "player",
    "balance",
    "error",
    "CAP-03"
  ]
}
