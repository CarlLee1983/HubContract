{
  "id": "server-status-ignored-auth",
  "name": "Server status: invalid Station credentials are ignored",
  "description": "Route #20 / D-36: unlike the signed v1 routes, status has no validation, signature, or Station lookup gate.",
  "route": {
    "method": "GET",
    "path": "/v1/server/status"
  },
  "tags": ["server", "status", "unauthenticated", "D-36"],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "query": {
      "station_code": "NON_EXISTENT_STATION",
      "timestamp": 0,
      "sign": "invalid_signature_hex_value_12345"
    }
  }
}
