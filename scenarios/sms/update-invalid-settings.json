{
  "id": "sms-update-invalid-settings",
  "name": "SMS update rejects non-JSON settings",
  "description": "Records settings.json validation error.",
  "route": {
    "method": "POST",
    "path": "/v1/sms"
  },
  "tags": [
    "sms",
    "update",
    "invalid",
    "settings"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "body": {
      "station_code": "DEMO_STATION",
      "timestamp": 0,
      "hub_sms_id": 1,
      "settings": "not-json"
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "normalizers": [
    {
      "target": "request.body.timestamp",
      "type": "current_timestamp"
    }
  ],
  "dbProbe": {
    "queries": [
      {
        "name": "sms",
        "sql": "SELECT id, station_id, code, name, supplier, active, amount, settings FROM sms ORDER BY id",
        "params": []
      }
    ]
  }
}
