{
  "id": "sms-send-validation",
  "name": "SMS send validation",
  "description": "Records route-specific FormRequest 422 validation envelope with a valid station and generated signature.",
  "route": {
    "method": "POST",
    "path": "/v1/sms/send"
  },
  "tags": [
    "sms",
    "send",
    "validation"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "body": {
      "station_code": "DEMO_STATION",
      "timestamp": 0,
      "hub_sms_id": 1,
      "phone": "+84901234567",
      "currency": "TWD"
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "mongoProbe": { "collections": ["httplog_sms_send"] },
  "normalizers": [
    {
      "target": "request.body.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    },
    {"target": "mongo.httplog_sms_send.0.datetime", "type": "mask", "replacement": "<DATETIME>"},
    {"target": "mongo.httplog_sms_send.0.context.datetime", "type": "mask", "replacement": "<DATETIME>"},
    {"target": "mongo.httplog_sms_send.0.context.uri", "type": "regex_replace", "pattern": "api_password=[^&]+", "replacement": "api_password=<API_PASSWORD>"},
    {"target": "mongo.httplog_sms_send.0.context.request.api_password", "type": "mask", "replacement": "<API_PASSWORD>"},
    {"target": "mongo.httplog_sms_send.0.context.request.sign", "type": "mask", "replacement": "<SIGNATURE>"},
    {"target": "mongo.httplog_sms_send.0.context.request.rand", "type": "mask", "replacement": "<RANDOM>"}
  ]
}
