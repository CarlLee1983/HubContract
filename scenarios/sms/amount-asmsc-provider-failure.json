{
  "id": "sms-amount-asmsc-provider-failure",
  "name": "SMS amount asmsc provider-failure",
  "description": "Records asmsc live supplier amount response; smsCost=2, successful balance 19 converts to 9 messages. Supplier failure returns zero.",
  "route": {
    "method": "POST",
    "path": "/v1/sms/amount"
  },
  "tags": [
    "sms",
    "amount",
    "asmsc",
    "provider-failure"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "body": {
      "station_code": "DEMO_STATION",
      "timestamp": 0,
      "hub_sms_id": 4
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "normalizers": [
    {
      "target": "request.body.timestamp",
      "type": "current_timestamp"
    },
    {
      "target": "response.body.file",
      "type": "mask",
      "replacement": "<MASKED_FILE_PATH>"
    },
    {
      "target": "response.body.trace",
      "type": "mask",
      "replacement": "<MASKED_TRACE>"
    }
  ],
  "dbProbe": {
    "queries": [
      {
        "name": "sms",
        "sql": "SELECT id, station_id, code, name, supplier, active, amount, settings FROM sms ORDER BY id",
        "params": []
      }
    ]
  },
  "stub": {
    "script": {
      "matchers": [
        {
          "method": "GET",
          "path": "/api/CheckBalance",
          "response": {
            "status": 200,
            "body": {
              "Message": "synthetic supplier failure"
            }
          }
        }
      ]
    }
  }
}
