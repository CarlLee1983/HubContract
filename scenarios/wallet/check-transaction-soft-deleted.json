{
  "id": "check-transaction-soft-deleted",
  "name": "Check Transaction: Soft Deleted Order",
  "description": "CAP-06 LookupOrder: Verify check-transaction excludes soft deleted records and returns ORDER_NOT_FOUND (LO-3)",
  "route": {
    "method": "POST",
    "path": "/v1/wallet/check-transaction"
  },
  "tags": ["wallet", "pilot", "check-transaction"],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json"
    },
    "body": {
      "station_code": "DEMO_STATION",
      "txn_no": "TRADE_DEP_SOFT_DELETED",
      "timestamp": 0
    },
    "signWith": {
      "secretKey": "synthetic_secret_key_for_contract_testing_only_1234567890"
    }
  },
  "dbProbe": {
    "queries": [
      {
        "name": "soft_deleted_record",
        "sql": "SELECT no, trade_no, deleted_at FROM deposit_records WHERE trade_no = ?",
        "params": ["TRADE_DEP_SOFT_DELETED"]
      }
    ]
  },
  "normalizers": [
    {
      "target": "request.body.timestamp",
      "type": "current_timestamp"
    }
  ]
}
