{
  "id": "mcp-platform-maintenance-index",
  "name": "MCP Platform Maintenance: Index",
  "description": "Verify authenticated GET /mcp/platform-maintenance lists the pre-existing cq9 maintenance flag, reports Redis availability, and leaves the flag unchanged.",
  "route": {
    "method": "GET",
    "path": "/mcp/platform-maintenance"
  },
  "tags": [
    "mcp",
    "platform-maintenance"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json",
      "X-Station-Mcp-Secret": "synthetic_mcp_secret_for_contract_testing_only_9f3a1c"
    }
  },
  "preconditions": {
    "mcpMaintenance": {
      "platform": "cq9",
      "duration": "1h",
      "reason": "Contract testing maintenance flag"
    }
  },
  "redisProbe": {
    "keys": [
      {
        "pattern": "platform-maintenance:v1:cq9",
        "db": 1,
        "ttlToleranceSeconds": 30
      }
    ]
  },
  "normalizers": [
    {
      "target": "response.body.data.items.cq9.set_at",
      "type": "regex_replace",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\+08:00$",
      "replacement": "<ISO8601+08:00>"
    },
    {
      "target": "response.body.data.items.cq9.until",
      "type": "regex_replace",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\+08:00$",
      "replacement": "<ISO8601+08:00>"
    },
    {
      "target": "response.body.data.items.cq9.remaining_seconds",
      "type": "regex_replace",
      "pattern": "^.*$",
      "replacement": "<NORMALIZED_SECONDS>"
    },
    {
      "target": "redis.platform-maintenance:v1:cq9.value.set_at",
      "type": "regex_replace",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\+08:00$",
      "replacement": "<ISO8601+08:00>"
    },
    {
      "target": "redis.platform-maintenance:v1:cq9.value.until",
      "type": "regex_replace",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\+08:00$",
      "replacement": "<ISO8601+08:00>"
    }
  ]
}
