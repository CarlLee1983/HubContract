{
  "id": "mcp-platform-maintenance-wrong-secret",
  "name": "MCP Platform Maintenance: Wrong Secret Rejected",
  "description": "DELETE with a wrong X-Station-Mcp-Secret must return 403 and preserve the pre-existing Redis maintenance flag. The before/after probe detects clearing or replacement of the flag.",
  "route": {
    "method": "DELETE",
    "path": "/mcp/platform-maintenance/cq9"
  },
  "tags": [
    "mcp",
    "platform-maintenance",
    "error"
  ],
  "request": {
    "headers": {
      "Host": "localhost:8080",
      "Accept": "application/json",
      "X-Station-Mcp-Secret": "synthetic_wrong_mcp_secret_for_contract_testing_only"
    }
  },
  "preconditions": {
    "mcpMaintenance": {
      "platform": "cq9",
      "duration": "1h",
      "reason": "Contract testing maintenance flag"
    }
  },
  "redisProbe": {
    "keys": [
      {
        "pattern": "platform-maintenance:v1:cq9",
        "db": 1
      }
    ]
  },
  "normalizers": [
    {
      "target": "redis.platform-maintenance:v1:cq9.value.set_at",
      "type": "regex_replace",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\+08:00$",
      "replacement": "<ISO8601+08:00>"
    },
    {
      "target": "redis.platform-maintenance:v1:cq9.value.until",
      "type": "regex_replace",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\+08:00$",
      "replacement": "<ISO8601+08:00>"
    }
  ]
}
