SMS_TEST=true
API_VALID_SIGNATURE_TIME=30

# Synthetic MCP secret and IP allowlist for the recording environment (Issue #7).
# Not a real credential — used only to make sure VerifyMcpSecret / RestrictMcpAllowedIps
# actually enforce something locally, instead of silently no-op'ing when APP_ENV=local
# and these are empty. HUB_MCP_ALLOWED_IPS is normally overridden below by
# docker-compose.yml's `legacy-app.environment.HUB_MCP_ALLOWED_IPS` (Issue #8) —
# Laravel's dotenv never overwrites a real process env var that's already set,
# so the value here is only a fallback for running this .env file outside that
# compose service. It must match docker-compose.yml's network gateway:
# empirically, requests from the host (via `curl http://localhost:8080/...`)
# arrive inside this container with that gateway IP as their source on Docker
# Desktop for Mac (confirmed via the built-in PHP server's access log in
# `docker logs`). 127.0.0.1 is included because the container's own healthcheck
# calls itself over loopback.
HUB_MCP_SECRET=synthetic_mcp_secret_for_contract_testing_only_9f3a1c
HUB_MCP_ALLOWED_IPS=172.29.0.1,127.0.0.1
