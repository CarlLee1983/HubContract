APP_KEY=base64:zrc/kxcjvYxAc7pawLj5zAGWPPyL7IIHG3cF0ICRO+A=
APP_DEBUG=true
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=en
APP_FALLBACK_LOCALE=en_us

APP_DOMAIN_ADMIN="cmghubadmin.test"
APP_DOMAIN_WEB="cmghub.test"
APP_DOMAIN_API="localhost:8080"

APP_DOMAINS_ADMIN="cmghubadmin.test"
APP_DOMAINS_WEB="cmghub.test"
