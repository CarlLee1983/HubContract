API_VALID_SIGNATURE_TIME=30

# Synthetic MCP secret for the recording environment (Issue #7). Not a real
# credential — used only to make sure VerifyMcpSecret actually enforces
# something locally, instead of silently no-op'ing when APP_ENV=local and this
# is empty.
#
# HUB_MCP_ALLOWED_IPS is intentionally NOT set here — this file is only ever
# mounted into the legacy-app compose service (docker-compose.yml), which
# always sets it via `legacy-app.environment.HUB_MCP_ALLOWED_IPS`, tracking
# that project's own network GATEWAY (Issue #8). A fallback value here would
# be dead config with no real code path exercising it, and wrong for every
# project except whichever one it was last hardcoded for. Laravel's dotenv
# never overwrites a real process env var that's already set, so the
# compose-provided value always wins.
HUB_MCP_SECRET=synthetic_mcp_secret_for_contract_testing_only_9f3a1c
